            {
              "line": 1,
              "text": "# An experimental test on the effects of dispersal from different habitat "
            },
            {
              "line": 7,
              "text": "#   João C. Nabout, Fabricio B. Teresa, Maisa C. Vieira, "
            },
            {
              "line": 20,
              "text": "# Tanks A0 (UFG -              did not receive dispersers): 1,  5, 6, 7, 8,18,20,28,30,38"
            },
            {
              "line": 21,
              "text": "# Tanks AA (UFG and dispersers from paired A0 tank):        16,15, 4,26,22, 2,23,25,21,13"
            },
            {
              "line": 23,
              "text": "# Tanks B0 (SantaBranca (SB) - did not receive dispersers):  3,11,12,17,19,24,29,32,36,40"
            },
            {
              "line": 24,
              "text": "# Tanks AB (UFG and dispersers from paired B0 tank):        31,35,14,34, 9,27,33,39,10,37"
            },
            {
              "line": 26,
              "text": "# Donor and recipient tanks (column 1 in comm.data below)"
            },
            {
              "line": 29,
              "text": "pairs <- cbind(donor, recipient)"
            },
            {
              "line": 37,
              "text": "# Samples obtained on days 20, 50, 65, 86 and 101 after filling of tanks."
            },
            {
              "line": 38,
              "text": "# Dispersal events immediately after sampling on days 50, 65 and 86."
            },
            {
              "line": 40,
              "text": "comm.data <- read.table('Dadosbrutosfinais1.1.txt' , sep = \"\\t\" , "
            },
            {
              "line": 43,
              "text": "# 1st column: Tank number (40 tanks)"
            },
            {
              "line": 45,
              "text": "# 3rd column: Treatment (4 levels)"
            },
            {
              "line": 46,
              "text": "# Remaining columns: Raw abundance data."
            },
            {
              "line": 47,
              "text": "comm.data[comm.data$Tratamento==\"AA\",\"Tratamento\"] <- \"Aa\" # To be consistent with text."
            },
            {
              "line": 48,
              "text": "comm.data[comm.data$Tratamento==\"AB\",\"Tratamento\"] <- \"Ab\""
            },
            {
              "line": 50,
              "text": "comm.data[1:5, c(1:3, 28, 29, 58, 59)] # Labels and columns to remove."
            },
            {
              "line": 51,
              "text": "comm <- comm.data[,-c(1:3, 28, 29, 58, 59)] # Remove labels and young copepod."
            },
            {
              "line": 52,
              "text": "dim(comm)# 200 63.  200 = 40 tanks * 5 sampling events"
            },
            {
              "line": 54,
              "text": "Tanks     <- comm.data[, \"Tanques\"]"
            },
            {
              "line": 56,
              "text": "Treatment <- comm.data[, \"Tratamento\"]"
            },
            {
              "line": 58,
              "text": "# Create composite labels and use as rownames."
            },
            {
              "line": 63,
              "text": "# Species groups"
            },
            {
              "line": 100,
              "text": "dim(comm) # 200 sample units and 63 species."
            },
            {
              "line": 101,
              "text": "sum(colSums(comm)>0) # 63 species"
            },
            {
              "line": 102,
              "text": "sum(comm) # Total abundance in the study: 88774 individuals"
            },
            {
              "line": 103,
              "text": "mean(rowSums(comm)) # Mean abundance per sample: 443.87"
            },
            {
              "line": 104,
              "text": "range(rowSums(comm))# Range abundances per sample: 126 1225"
            },
            {
              "line": 105,
              "text": "table(groups$group) # Cladocera  Copepoda  Rotifera  Testacea "
            },
            {
              "line": 115,
              "text": "range(colSums(comm))# Abundances of rarest and commonest species: 38 4792."
            },
            {
              "line": 121,
              "text": "# Sobs in tanks filled with water of lakes A and B before dispersal events."
            },
            {
              "line": 123,
              "text": "AB.T1T2 <- comm[                                    Date %in% c(\"T1\",\"T2\"),]"
            },
            {
              "line": 124,
              "text": "dim(AB.T1T2) # 80 63.  80 = 2 sampling events * 4 treatments * 10 tanks."
            },
            {
              "line": 125,
              "text": "AB.T1T2 <- AB.T1T2[, colSums(AB.T1T2)>0] # In case of species missing in T1-T2."
            },
            {
              "line": 126,
              "text": "dim(AB.T1T2) # 80 63"
            },
            {
              "line": 128,
              "text": "# Sobs in tanks filled with water of lake A before dispersal events."
            },
            {
              "line": 129,
              "text": "A.T1T2 <- comm[Treatment %in% c(\"A0\", \"Aa\", \"Ab\") & Date %in% c(\"T1\",\"T2\"),]"
            },
            {
              "line": 130,
              "text": "dim(A.T1T2) # 60 63.  60 = 2 dates * 3 treatments * 10 replicate tanks."
            },
            {
              "line": 131,
              "text": "A.T1T2 <- A.T1T2[, colSums(A.T1T2)>0] # Remove missing species"
            },
            {
              "line": 134,
              "text": "# Sobs in tanks filled with water of lake B before dispersal events."
            },
            {
              "line": 135,
              "text": "B.T1T2 <- comm[Treatment %in%   \"B0\"              & Date %in% c(\"T1\",\"T2\"),]"
            },
            {
              "line": 136,
              "text": "dim(B.T1T2) # 20 63.  20 = 2 dates * 1 treatment * 10 repliacte tanks."
            },
            {
              "line": 137,
              "text": "B.T1T2 <- B.T1T2[, colSums(B.T1T2)>0] # Remove missing species"
            },
            {
              "line": 140,
              "text": "sum(colnames(A.T1T2) %in% colnames(B.T1T2))# 12 species in common."
            },
            {
              "line": 142,
              "text": "38-12 # 26 species exclusive to tanks filled with water of lake A."
            },
            {
              "line": 143,
              "text": "37-12 # 25 species exclusive to tanks filled with water of lake B."
            },
            {
              "line": 144,
              "text": "rm(AB.T1T2, A.T1T2, B.T1T2)"
            },
            {
              "line": 148,
              "text": "#                      rm-Anova on observed species richness "
            },
            {
              "line": 151,
              "text": "dat.aov <- data.frame(S.obs, Treatment, Date, Tanks)"
            },
            {
              "line": 153,
              "text": "                  dv = S.obs,          # Dependent variable"
            },
            {
              "line": 154,
              "text": "                  wid = Tanks,         # Subject"
            },
            {
              "line": 155,
              "text": "                  within = Date,       # Time (Within-subject factor)"
            },
            {
              "line": 156,
              "text": "                  between = Treatment, # Between-subject factor"
            },
